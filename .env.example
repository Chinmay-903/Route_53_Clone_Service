# Copy to backend/.env and fill in real values. Never commit the filled copy.
# Every value here is a placeholder; none is a working credential.

# --- Backend ---------------------------------------------------------------

# SQLAlchemy URL. Local development uses a plain file; production mounts this
# path on a persistent volume (see docs/adr/0005-sqlite-persistence.md).
DATABASE_URL=sqlite:///./route53.db

# Signs and verifies session identifiers. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-48-random-url-safe-bytes

# Browser origins permitted to send credentialed requests. Comma-separated.
# A wildcard is rejected at startup because browsers refuse "*" with credentials.
CORS_ORIGINS=http://localhost:3000

# "development" | "production". Production gates /docs and /redoc and requires
# Secure cookies.
ENVIRONMENT=development

# "lax" locally. A split deployment (console and API on different domains) is
# cross-site, where a Lax cookie is never sent — set "none" there, which also
# forces Secure. See docs/DEPLOYMENT.md.
COOKIE_SAMESITE=lax

# Emits the seeded demo account. Credentials are shown on the login page by
# design; see docs/SECURITY.md for why that is an accepted trade-off.
DEMO_USER_EMAIL=demo@route53clone.dev
DEMO_USER_PASSWORD=replace-me-locally

# --- Frontend --------------------------------------------------------------

# Public by definition: the browser must know where the API lives. Only values
# that are safe to ship in a JS bundle may carry the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
